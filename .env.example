# Database Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit your actual .env file to version control.

SPA_DB_HOST=localhost
SPA_DB_USER=root
SPA_DB_PASS=
SPA_DB_NAME=spa_db
SPA_DB_PORT=3306

# Application Mode (production / development)
SPA_ENV=production

# Automatic Schema Migrations (0 = disabled in production, 1 = run migrations)
SPA_AUTO_MIGRATE=0
